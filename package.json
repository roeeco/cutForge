{
  "name": "cutforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bugs": "vitest run -c vitest.bugs.config.ts",
    "e2e": "playwright test --trace off",
    "typecheck": "tsc -b --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "dev:worker": "wrangler d1 migrations apply cutforge --local && wrangler dev --port 8787",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply cutforge --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "bidi-js": "^1.1.0",
    "drizzle-orm": "^0.45.4",
    "immer": "^11.2.9",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
